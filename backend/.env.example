NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://rescuesync:CAMBIAR_PASSWORD@localhost:5432/rescuesync"
TEST_DATABASE_URL="postgresql://rescuesync:CAMBIAR_PASSWORD@localhost:5432/rescuesync_test"
BONITA_ENABLED=false
BONITA_URL=http://localhost:8080/bonita
BONITA_USERNAME=
BONITA_PASSWORD=
BONITA_PROCESS_ID=
BONITA_TIMEOUT_MS=10000
# Solo IDs de definiciones verificadas según BONITA_WORKFLOW.md; vacío bloquea los tramos nuevos.
BONITA_WORKFLOW_PROCESS_IDS=
# Secreto exclusivo de los conectores (mínimo 32 caracteres); nunca VITE_*.
BONITA_CALLBACK_SECRET=
# DESARROLLO permite seleccionar ofertas activas sin Sistema Nacional; PENDIENTE es el valor seguro inicial.
OFERTAS_VALIDACION_MODE=PENDIENTE
